# ---------------------------------------------------------------------------
# Daily Quiz — environment variables (server-side only; never exposed to browser)
#
# Local dev with Cloudflare adapter reads secrets from `.dev.vars` (same KEY=value
# format). Copy these keys into `.dev.vars` for `yarn dev`. For production, set them
# as Worker secrets:  wrangler secret put OPENAI_API_KEY   (etc.)
# ---------------------------------------------------------------------------

# OpenAI (provider chosen for this app)
OPENAI_API_KEY=
# Optional — defaults to gpt-4o if unset
OPENAI_MODEL=gpt-4o
# Optional — for OpenAI-compatible/proxy endpoints
# OPENAI_BASE_URL=

# Supabase
SUPABASE_URL=
# Service role key: server-side ONLY. Never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key (optional; not required by the current server-only data flow)
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# /live — private retro webcam + chat room  (see docs/LIVE_SETUP.md)
# Never put real values in this file; use `.dev.vars` locally and
# `wrangler secret put NAME` in production.
# ---------------------------------------------------------------------------

# Cloudflare Access — the primary gate for /live. Until BOTH of these and
# AUTHORIZED_VIEWER_EMAIL are set, /live is closed to everyone (fail closed).
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=

# The single email address allowed to watch. Exact match, no wildcards.
AUTHORIZED_VIEWER_EMAIL=viewer@example.com

# High-entropy secret the broadcaster dashboard presents to open the socket.
# Generate with: openssl rand -base64 32
BROADCASTER_TOKEN=

# Cute window title shown to the viewer (optional).
LIVE_TITLE=our little window

# ICE. STUN alone is enough on most home networks; TURN is the fallback for
# strict/cellular NATs. Pick ONE turn source.
STUN_URLS=stun:stun.cloudflare.com:3478
# 1. Cloudflare Realtime TURN (easiest — short-lived credentials, no VPS)
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# 2. self-hosted coturn with `use-auth-secret` (short-lived credentials)
TURN_URL=
TURN_SECRET=
# 3. static credentials (least preferred — long-lived)
TURN_USERNAME=
TURN_CREDENTIAL=

# Relay all media through TURN so peer IP addresses stay hidden.
FORCE_TURN=false

# Development only. Skips Cloudflare Access, and ONLY works when the request
# host is localhost/127.0.0.1. Never set this on the deployed Worker.
LIVE_DEV_OPEN=false


